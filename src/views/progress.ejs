<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <style>
        :root{
            --bg:#0b0b0c;
            --panel:#151517;
            --panel2:#1d1d20;
            --gold:#d4a017;
            --gold-soft:#f6d878;
            --text:#f5f5f5;
            --muted:#9ca3af;
            --border:#2a2a2f;
            --danger:#ef4444;
            --success:#22c55e;
        }

        *{
            box-sizing:border-box;
            margin:0;
            padding:0;
        }

        body{
            background:
                radial-gradient(circle at top right, rgba(212,160,23,0.12), transparent 20%),
                #0b0b0c;

            color:var(--text);
            font-family: "Segoe UI", sans-serif;
        }

        main{
            max-width:1300px;
            margin:auto;
            padding:40px 24px 80px;
        }

        header{
            display:flex;
            justify-content:space-between;
            align-items:end;
            margin-bottom:28px;
            flex-wrap:wrap;
            gap:20px;
        }

        h1{
            font-size:3rem;
            margin-top:10px;
        }

        a{
            text-decoration:none;
            color:var(--gold-soft);
            font-weight:700;
        }

        .layout{
            display:grid;
            grid-template-columns:340px 1fr;
            gap:24px;
        }

        .panel{
            background:linear-gradient(145deg,#171719,#111113);
            border:1px solid var(--border);
            border-radius:24px;
            padding:28px;
        }

        .panel h2{
            margin-bottom:10px;
            color:var(--gold-soft);
        }

        .muted{
            color:var(--muted);
            line-height:1.7;
        }

        form{
            margin-top:22px;
        }

        input, textarea{
            width:100%;
            margin-bottom:14px;
            padding:14px;
            border-radius:14px;
            border:1px solid var(--border);
            background:#0f0f11;
            color:white;
            font-size:0.95rem;
        }

        textarea{
            resize:none;
            min-height:100px;
        }

        button{
            width:100%;
            padding:14px;
            border:none;
            border-radius:14px;
            background:var(--gold);
            color:black;
            font-weight:800;
            cursor:pointer;
            transition:0.25s;
        }

        button:hover{
            transform:translateY(-2px);
        }

        table{
            width:100%;
            border-collapse:collapse;
            overflow:hidden;
            border-radius:20px;
            background:linear-gradient(145deg,#171719,#111113);
            border:1px solid var(--border);
        }

        th{
            background:#1b1b1f;
            color:var(--gold-soft);
            text-align:left;
            padding:18px;
            font-size:0.9rem;
            letter-spacing:1px;
        }

        td{
            padding:18px;
            border-top:1px solid rgba(255,255,255,0.05);
            color:#e5e7eb;
        }

        tr:hover{
            background:rgba(255,255,255,0.02);
        }

        .notice{
            margin-bottom:20px;
            padding:16px;
            border-radius:14px;
            background:rgba(34,197,94,0.15);
            border:1px solid rgba(34,197,94,0.3);
            color:#bbf7d0;
        }

        .error{
            margin-bottom:20px;
            padding:16px;
            border-radius:14px;
            background:rgba(239,68,68,0.15);
            border:1px solid rgba(239,68,68,0.3);
            color:#fecaca;
        }

        .empty{
            padding:40px;
            text-align:center;
            border-radius:20px;
            background:linear-gradient(145deg,#171719,#111113);
            border:1px solid var(--border);
            color:var(--muted);
        }

        .weight{
            color:var(--gold-soft);
            font-weight:800;
            font-size:1.1rem;
        }

        @media(max-width:950px){

            .layout{
                grid-template-columns:1fr;
            }

            h1{
                font-size:2.3rem;
            }
        }

    </style>
</head>

<body>

<main>

<header>

    <div>
        <a href="/">← Back to dashboard</a>
        <h1>Member Progress</h1>
    </div>

    <p class="muted">
        Track body measurements and transformation history.
    </p>

</header>

<!-- SUCCESS / ERROR -->

<% if (message) { %>

    <div class="<%= messageType === 'error' ? 'error' : 'notice' %>">
        <%= message %>
    </div>

<% } %>

<% if (error) { %>

    <div class="error">
        <%= error %>
    </div>

<% } %>

<section class="layout">

    <!-- CREATE PANEL -->

    <aside class="panel">

        <h2>Add Progress</h2>

        <p class="muted">
            Record weight updates and transformation notes for members.
        </p>

        <form method="post" action="/views/progress">

            <input
                type="number"
                name="member_id"
                placeholder="Member ID"
                required
            />

            <input
                type="number"
                step="0.1"
                name="weight"
                placeholder="Weight"
                required
            />

            <textarea
                name="notes"
                placeholder="Transformation notes..."
            ></textarea>

            <button type="submit">
                Save Progress
            </button>

        </form>

    </aside>

    <!-- TABLE -->

    <section>

        <% if (!progress.length) { %>

            <div class="empty">
                No progress records found.
            </div>

        <% } else { %>

        <table>

            <thead>

                <tr>
                    <th>ID</th>
                    <th>Member ID</th>
                    <th>Weight</th>
                    <th>Notes</th>
                    <th>Recorded At</th>
                    <th>Actions</th>
                </tr>

            </thead>

            <tbody>

                <% progress.forEach(p => { %>

                <tr>

                    <td><%= p.id.progress_id %></td>

                    <td>
                        #<%= p.id.member_id %>
                    </td>

                    <td class="weight">
                        <%= p.id.weight %> kg
                    </td>

                    <td>
                        <%= p.id.notes || "No notes" %>
                    </td>

                    <td>
                        <%= p.id.recorded_at %>
                    </td>

                    <td>

                    <!-- UPDATE -->

                    <form
                        method="post"
                        action="/views/progress/<%= p.progress_id %>/update"
                    >

                        <input
                            type="number"
                            step="0.1"
                            name="weight"
                            value="<%= p.weight %>"
                            required
                        />

                        <textarea
                            name="notes"
                        ><%= p.notes %></textarea>

                        <button type="submit">
                            Update
                        </button>

                    </form>

                    <br>

                    <!-- DELETE -->

                    <form
                        method="post"
                        action="/views/progress/<%= p.progress_id %>/delete"
                    >

                        <button
                            type="submit"
                            style="
                                background:#ef4444;
                                color:white;
                            "
                        >
                            Delete
                        </button>

                    </form>

                    </td>

                </tr>

                <% }) %>

            </tbody>

        </table>

        <% } %>

    </section>

</section>

</main>

</body>
</html>