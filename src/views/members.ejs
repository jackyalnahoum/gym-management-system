<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%= title %></title>

    <!-- KEEP SAME STYLE (DOCTOR STYLE) -->
    <style>
        :root {
            --bg: #0b0b0b;
            --panel: #111111;
            --ink: #f5f5f5;
            --muted: #a1a1aa;
            --accent: #d4af37; 
            --accent-dark: #b8962e;
            --danger: #ef4444;
            --border: #1f1f1f;
        }
        * { box-sizing: border-box; }
        body {
            margin: 0;
            font-family: "Playfair Display", serif;
            background:
                
                var(--bg);
            color: var(--ink);
        }
        main {
            max-width: 1150px;
            margin: 0 auto;
            padding: 40px 20px 60px;
        }
        header {
            display: flex;
            justify-content: space-between;
            gap: 16px;
            align-items: end;
            margin-bottom: 24px;
            flex-wrap: wrap;
        }
        h1, h2 { margin: 0; }
        a { color: var(--accent); text-decoration: none; font-weight: 700; }

        .notice { background: #dcfce7; padding: 14px; border-radius: 12px; }
        .error { background: #fee2e2; padding: 14px; border-radius: 12px; }

        .layout {
            display: grid;
            grid-template-columns: 320px 1fr;
            gap: 20px;
        }

        .panel {
            background: rgba(255, 255, 255, 0.03);
            padding: 1px solid var(--border);
            border-radius: 18px;
            border: blur(10px);
        }

        input {
            width: 100%;
            padding: 10px;
            margin-top: 5px;
            border-radius: 10px;
            border: 1px solid var(--border);
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid var(--border);
        }

        button {
            border-radius: 12px;
            font-weight: bold;
        }

        .primary { background: var(--accent); color: black; }
        .secondary { background:#1f2937; color: white;}
        .danger { background: #3f1d1d; }

    </style>
</head>

<body>
<main>

<header>
    <div>
        <a href="/">Back to dashboard</a>
        <h1>Members</h1>
    </div>
</header>

<!-- SUCCESS / ERROR -->
<% if (message) { %>
    <div class="<%= messageType === 'error' ? 'error' : 'notice' %>">
        <%= message %>
    </div>
<% } %>

<% if (error) { %>
    <div class="error"><%= error %></div>
<% } %>

<section class="layout">

<!-- CREATE -->
<aside class="panel">
    <h2>Create Member</h2>

    <form method="post" action="/views/members">

        <input type="text" name="full_name" placeholder="Full name" required />
        <input type="email" name="email" placeholder="Email" required />
        <input type="text" name="password" placeholder="Password" required />
        <input type="text" name="phone" placeholder="Phone" />
        <input type="number" name="age" placeholder="Age" />

        <button class="primary">Create</button>
    </form>
</aside>

<!-- TABLE -->
<section>

    <% if (!members.length) { %>
        <p>No members found</p>
    <% } else { %>
    
    <input
    type="text"
    id="searchInput"
    placeholder="Search members..."
    style="
        width:100%;
        padding:14px;
        margin-bottom:20px;
        border-radius:14px;
        border:1px solid #2a2a2f;
        background:#111113;
        color:white;
    "
>


    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Member</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            <% members.forEach(member => { %>

            <tr>
                <td><%= member.member_id %></td>

                <td>
                    <strong><%= member.full_name %></strong><br>
                    <%= member.email %>
                </td>

                <td>

                    <!-- UPDATE -->
                    <form method="post" action="/views/members/<%= member.member_id %>/update">
                        <input type="text" name="full_name" value="<%= member.full_name %>" required />
                        <input type="email" name="email" value="<%= member.email %>" required />
                        <input type="text" name="phone" value="<%= member.phone %>" />
                        <input type="number" name="age" value="<%= member.age %>" />
                        <button class="secondary">Update</button>
                    </form>

                    <!-- DELETE -->
                    <form method="post" action="/views/members/<%= member.member_id %>/delete">
                        <button class="danger">Delete</button>
                    </form>

                </td>
            </tr>

            <% }) %>

             <script>

            const searchInput =
                document.getElementById("searchInput");

            searchInput.addEventListener("keyup", function () {

                const value =
                    this.value.toLowerCase();

                const rows =
                    document.querySelectorAll("tbody tr");

                rows.forEach(row => {

                    row.style.display =
                        row.innerText
                            .toLowerCase()
                            .includes(value)
                                ? ""
                                : "none";
                });

            });

            </script>  
        </tbody>

    </table>

    <% } %>

</section>

</section>

</main>
</body>
</html>